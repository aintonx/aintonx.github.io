{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node tools/validate.mjs index.html",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
