-- ═══════════════════════════════════════════════════════════════════
-- ТАБЛИЦЫ ЗАЯВОК · EchoWorld
--
-- Две формы сайта собирают данные, которым до сих пор некуда было лечь:
--   «Заказать конденсацию»  → condensation_requests
--   «Возврат реликвии»      → return_requests
--
-- Ни в той, ни в другой нет денег и платёжных ключей — поэтому их можно
-- включать, не дожидаясь ЮKassa.
--
-- Как применить: консоль Яндекс Облака → ваша база YDB → вкладка «SQL-запрос»
-- → вставить весь этот файл → «Выполнить». Повторный запуск на уже
-- существующей таблице выдаст ошибку «path exists» — это нормально и
-- ничего не ломает, просто значит, что таблица уже создана.
--
-- Имена полей намеренно совпадают с тем, что шлёт сайт, чтобы между
-- формой и базой не было слоя переименований, в котором легко ошибиться.
-- ═══════════════════════════════════════════════════════════════════


-- ── ЗАЯВКА НА КОНДЕНСАЦИЮ ──────────────────────────────────────────
-- Человек называет предмет, который хочет получить реликвией, и почту.
CREATE TABLE condensation_requests (
    -- Наш идентификатор записи. Считается от черновика заявки, поэтому
    -- повторная отправка той же формы не создаст дубль.
    id Utf8 NOT NULL,

    -- Черновик с фронта: cond_<время в 36-й системе>. Нужен для сверки,
    -- если человек напишет «я отправлял, но ничего не пришло».
    request_draft_id Utf8,

    -- Анонимный идентификатор вкладки. Не персональные данные: помогает
    -- связать заявку с другими действиями того же визита.
    client_session_id Utf8,

    item Utf8,          -- что за предмет просят сконденсировать
    email Utf8,         -- куда отвечать
    consent Bool,       -- согласие на обработку данных, без него не пишем

    source Utf8,        -- откуда пришла заявка (site)
    status Utf8,        -- new → in_review → done / rejected

    created_at_client Utf8,   -- время по часам посетителя, как есть
    created_at Timestamp,     -- время сервера, ему и верим
    updated_at Timestamp,

    PRIMARY KEY (id)
);


-- ── ЗАЯВКА НА ВОЗВРАТ ──────────────────────────────────────────────
-- «Сектор Тишины»: человек описывает, что пошло не так с реликвией.
CREATE TABLE return_requests (
    id Utf8 NOT NULL,

    return_draft_id Utf8,
    client_session_id Utf8,

    customer_name Utf8,
    customer_email Utf8,
    telegram Utf8,            -- необязательное поле формы

    relic_code Utf8,          -- артикул реликвии, формат ECH-XXXX
    order_id Utf8,            -- номер заказа, если посетитель его помнит
    reason Utf8,              -- свободное описание причины

    consent Bool,
    status Utf8,              -- new → in_review → approved / rejected

    created_at_client Utf8,
    created_at Timestamp,
    updated_at Timestamp,

    PRIMARY KEY (id)
);
